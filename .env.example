# Browser key for the map inside the embed.
# Enable "Maps JavaScript API" and "Places API" on this key.
# Restrict it by HTTP referrer to the Vercel domain, not formnutrition.com.
# The map runs inside an iframe, so Google sees the Vercel address.
# Examples:
#   http://localhost:3000/*
#   https://your-project.vercel.app/*
#   https://*.vercel.app/*
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Server key for placing addresses on the map (Geocoding API).
# Enable "Geocoding API". Restrict by IP if you can.
# Never start this name with NEXT_PUBLIC_. It must not reach the browser.
GOOGLE_MAPS_SERVER_KEY=

# Landers Supabase project (ref fadwglwxcbufjdivqapt, region eu-central-2).
# Stores are in table public.stores. The migration is already applied there.
SUPABASE_URL=https://fadwglwxcbufjdivqapt.supabase.co

# Landers service_role secret (starts with eyJ) or secret key (starts with sb_secret_).
# This key can read and write the whole landers database, not only the stores.
# Server only. Mark it Sensitive in Vercel. Never start the name with NEXT_PUBLIC_.
# Do not paste the anon or publishable key here.
SUPABASE_SERVICE_ROLE_KEY=

# Password for /admin. A long phrase is fine.
ADMIN_PASSWORD=

# Signs the login cookie. Generate one with: openssl rand -base64 32
AUTH_SECRET=
